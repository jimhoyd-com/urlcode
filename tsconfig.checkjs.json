// Phase one of JS type-checking (#568): build/release tooling only, not the
// 61 recipe/example .mjs files that ship as authoring material rather than
// project infrastructure. Widening further is a separate, deliberate step.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true
  },
  "include": [
    "scripts/pack-sources.mjs",
    "action/comment.mjs",
    "packages/admin/scripts",
    "packages/auth/scripts",
    "packages/ui/scripts"
  ]
}
