[
  {"path": "/contact", "status": 200, "expectHeaders": {"content-type": "text/html; charset=utf-8"}},
  {"path": "/contact", "method": "POST", "headers": {"content-type": "application/json"}, "body": "{\"name\":\"Ada\",\"email\":\"ada@example.com\",\"message\":\"Hello\"}", "status": 201, "expectBody": "{\"received\":true}", "expectHeaders": {"cache-control": "no-store"}},
  {"path": "/contact", "method": "POST", "headers": {"content-type": "application/json"}, "body": "{\"name\":\"Bot\",\"email\":\"bot@example.com\",\"message\":\"Buy\",\"website\":\"http://spam.example\"}", "status": 200, "expectBody": "{\"received\":true}"},
  {"path": "/contact", "method": "POST", "headers": {"content-type": "application/json"}, "body": "{\"name\":\"Ada\",\"email\":\"not an address\",\"message\":\"\"}", "status": 422, "expectBody": "{\"errors\":[\"email must be an address\",\"message must be 1-2000 characters\"]}"},
  {"path": "/contact", "method": "POST", "headers": {"content-type": "application/json"}, "body": "{\"name\":\"\",\"email\":\"a@b\",\"message\":\"x\"}", "status": 422, "expectBody": "{\"errors\":[\"name must be 1-80 characters\"]}"},
  {"path": "/contact", "method": "POST", "headers": {"content-type": "text/plain"}, "body": "name=Ada", "status": 415},
  {"path": "/contact", "method": "POST", "headers": {"content-type": "application/json"}, "body": "{\"name\":", "status": 400},
  {"path": "/contact", "method": "DELETE", "status": 405, "expectHeaders": {"allow": "GET, HEAD, POST"}},
  {"path": "/contact/other", "status": 404}
]
