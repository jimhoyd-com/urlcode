[
  {"path": "/r/docs", "status": 302, "expectHeaders": {"location": "https://docs.example.com/"}},
  {"path": "/r/jobs", "method": "HEAD", "status": 302, "expectHeaders": {"location": "https://example.com/careers"}},
  {"path": "/r/nope", "status": 404},
  {"path": "/r/Not-Valid", "status": 400},
  {"path": "/r/a", "status": 400},
  {"path": "/api/links/blog", "status": 200, "expectBody": "{\"code\":\"blog\",\"url\":\"https://example.com/blog\"}"},
  {"path": "/api/links/nope", "status": 404},
  {"path": "/api/links", "method": "POST", "headers": {"content-type": "application/json"}, "body": "{\"code\":\"team\",\"url\":\"https://example.com/team\"}", "status": 201, "expectBody": "{\"code\":\"team\",\"url\":\"https://example.com/team\"}"},
  {"path": "/api/links", "method": "POST", "headers": {"content-type": "application/json"}, "body": "{\"code\":\"docs\",\"url\":\"https://example.com/other\"}", "status": 422, "expectBody": "{\"errors\":[\"code already exists\"]}"},
  {"path": "/api/links", "method": "POST", "headers": {"content-type": "application/json"}, "body": "{\"code\":\"X\",\"url\":\"http://example.com/\"}", "status": 422, "expectBody": "{\"errors\":[\"invalid code\",\"url must be an https URL\"]}"},
  {"path": "/api/links", "method": "POST", "headers": {"content-type": "text/plain"}, "body": "code=x", "status": 415},
  {"path": "/api/links", "method": "POST", "headers": {"content-type": "application/json"}, "body": "{", "status": 400},
  {"path": "/api/links", "status": 405},
  {"path": "/health", "status": 200, "expectBody": "{\"ok\":true}"}
]
