{
  "collections": {
    "todos": {
      "mount": "/api/todos",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "done": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "sortable": [
        "title"
      ],
      "filterable": [
        "done"
      ]
    }
  }
}
