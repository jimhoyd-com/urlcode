{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "collections"
  ],
  "properties": {
    "collections": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mount",
          "fields"
        ],
        "properties": {
          "mount": {
            "type": "string",
            "pattern": "^/[A-Za-z0-9._~/-]*[A-Za-z0-9._~-]$",
            "maxLength": 256
          },
          "fields": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 64,
            "propertyNames": {
              "pattern": "^[a-z][A-Za-z0-9_]{0,63}$"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "string",
                    "integer",
                    "number",
                    "boolean"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "default": {
                  "oneOf": [
                    {
                      "type": "string",
                      "maxLength": 65536
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                },
                "minLength": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65536
                },
                "maxLength": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65536
                },
                "enum": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "items": {
                    "oneOf": [
                      {
                        "type": "string",
                        "maxLength": 256
                      },
                      {
                        "type": "number"
                      }
                    ]
                  }
                },
                "minimum": {
                  "type": "number"
                },
                "maximum": {
                  "type": "number"
                }
              }
            }
          },
          "maxRecords": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "maxRecordBytes": {
            "type": "integer",
            "minimum": 256,
            "maximum": 65536
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "readOnly": {
            "type": "boolean"
          },
          "sortable": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][A-Za-z0-9_]{0,63}$"
            }
          },
          "filterable": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][A-Za-z0-9_]{0,63}$"
            }
          }
        }
      }
    }
  }
}
