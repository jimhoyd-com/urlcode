{
  "name": "@jimhoyd/urlcode-admin",
  "version": "0.6.1",
  "type": "module",
  "description": "Administration console extension for URLCode, on top of the auth extension",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jimhoyd-com/urlcode.git",
    "directory": "packages/admin"
  },
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/check-sqlite.mjs",
    "test": "node --conditions=development --test --test-timeout=300000 test/*.test.ts",
    "verify": "npm run typecheck && npm run build && npm test"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./extension": {
      "types": "./dist/extension.d.ts",
      "default": "./dist/extension.js"
    }
  },
  "files": [
    "dist",
    "urlcode.json",
    "README.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md"
  ],
  "devDependencies": {
    "@jimhoyd/urlcode": "file:../..",
    "@jimhoyd/urlcode-ui": "file:../ui",
    "@jimhoyd/urlcode-auth": "file:../auth",
    "@types/node": "26.6.2",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@jimhoyd/urlcode": "0.6.1",
    "@jimhoyd/urlcode-auth": "0.6.1",
    "@jimhoyd/urlcode-ui": "0.6.1"
  },
  "homepage": "https://github.com/jimhoyd-com/urlcode/tree/main/packages/admin#readme",
  "bugs": {
    "url": "https://github.com/jimhoyd-com/urlcode/issues"
  },
  "peerDependenciesMeta": {
    "@jimhoyd/urlcode-auth": {
      "optional": true
    },
    "@jimhoyd/urlcode-ui": {
      "optional": true
    }
  }
}
