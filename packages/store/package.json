{
  "name": "@jimhoyd/urlcode-store",
  "version": "0.6.6",
  "type": "module",
  "description": "Operator-installed declarative data store extension for URLCode: SQLite-backed collections served as a bounded CRUD API",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jimhoyd-com/urlcode.git",
    "directory": "packages/store"
  },
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=development --import ../../test/scratch-tmpdir.ts --test --test-timeout=120000 test/*.test.ts",
    "verify": "npm run typecheck && npm run build && npm test"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./extension": {
      "development": "./src/extension.ts",
      "types": "./dist/extension.d.ts",
      "default": "./dist/extension.js"
    }
  },
  "files": [
    "dist",
    "urlcode.json",
    "README.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md"
  ],
  "devDependencies": {
    "@jimhoyd/urlcode": "file:../..",
    "@types/node": "26.6.4",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@jimhoyd/urlcode": "0.6.6"
  },
  "bin": {
    "urlcode-store": "./dist/cli.js"
  },
  "homepage": "https://github.com/jimhoyd-com/urlcode/tree/main/packages/store#readme",
  "bugs": {
    "url": "https://github.com/jimhoyd-com/urlcode/issues"
  }
}
