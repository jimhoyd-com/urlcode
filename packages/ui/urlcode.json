{
  "kind": "extension",
  "name": "ui",
  "description": "Shared presentation kit: theme, copy, templates and generated store screens for every extension page.",
  "requires": [],
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "theme": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80
          },
          "logo": {
            "type": "string",
            "maxLength": 512
          },
          "favicon": {
            "type": "string",
            "maxLength": 512
          },
          "backTo": {
            "type": "string",
            "maxLength": 1024
          },
          "colors": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "background": {
                "type": "string",
                "maxLength": 32
              },
              "foreground": {
                "type": "string",
                "maxLength": 32
              },
              "card": {
                "type": "string",
                "maxLength": 32
              },
              "cardForeground": {
                "type": "string",
                "maxLength": 32
              },
              "popover": {
                "type": "string",
                "maxLength": 32
              },
              "popoverForeground": {
                "type": "string",
                "maxLength": 32
              },
              "primary": {
                "type": "string",
                "maxLength": 32
              },
              "primaryForeground": {
                "type": "string",
                "maxLength": 32
              },
              "secondary": {
                "type": "string",
                "maxLength": 32
              },
              "secondaryForeground": {
                "type": "string",
                "maxLength": 32
              },
              "muted": {
                "type": "string",
                "maxLength": 32
              },
              "mutedForeground": {
                "type": "string",
                "maxLength": 32
              },
              "accent": {
                "type": "string",
                "maxLength": 32
              },
              "accentForeground": {
                "type": "string",
                "maxLength": 32
              },
              "destructive": {
                "type": "string",
                "maxLength": 32
              },
              "destructiveForeground": {
                "type": "string",
                "maxLength": 32
              },
              "border": {
                "type": "string",
                "maxLength": 32
              },
              "input": {
                "type": "string",
                "maxLength": 32
              },
              "ring": {
                "type": "string",
                "maxLength": 32
              },
              "dark": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "background": {
                    "type": "string",
                    "maxLength": 32
                  },
                  "foreground": {
                    "type": "string",
                    "maxLength": 32
                  },
                  "card": {
                    "type": "string",
                    "maxLength": 32
                  },
                  "cardForeground": {
                    "type": "string",
                    "maxLength": 32
                  },
                  "popover": {
                    "type": "string",
                    "maxLength": 32
                  },
                  "popoverForeground": {
                    "type": "string",
                    "maxLength": 32
                  },
                  "primary": {
                    "type": "string",
                    "maxLength": 32
                  },
                  "primaryForeground": {
                    "type": "string",
                    "maxLength": 32
                  },
                  "secondary": {
                    "type": "string",
                    "maxLength": 32
                  },
                  "secondaryForeground": {
                    "type": "string",
                    "maxLength": 32
                  },
                  "muted": {
                    "type": "string",
                    "maxLength": 32
                  },
                  "mutedForeground": {
                    "type": "string",
                    "maxLength": 32
                  },
                  "accent": {
                    "type": "string",
                    "maxLength": 32
                  },
                  "accentForeground": {
                    "type": "string",
                    "maxLength": 32
                  },
                  "destructive": {
                    "type": "string",
                    "maxLength": 32
                  },
                  "destructiveForeground": {
                    "type": "string",
                    "maxLength": 32
                  },
                  "border": {
                    "type": "string",
                    "maxLength": 32
                  },
                  "input": {
                    "type": "string",
                    "maxLength": 32
                  },
                  "ring": {
                    "type": "string",
                    "maxLength": 32
                  }
                }
              }
            }
          },
          "radius": {
            "type": "string",
            "maxLength": 16
          },
          "font": {
            "type": "string",
            "maxLength": 128
          }
        }
      },
      "languages": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "maxLength": 35
        }
      },
      "copy": {
        "type": "string",
        "maxLength": 256
      },
      "templates": {
        "type": "string",
        "maxLength": 256
      },
      "stylesheet": {
        "oneOf": [
          {
            "type": "string",
            "maxLength": 256
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file"
            ],
            "properties": {
              "file": {
                "type": "string",
                "maxLength": 256
              },
              "replace": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      "hooks": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "transformView": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source"
                ],
                "properties": {
                  "source": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "export": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                  },
                  "sandbox": {
                    "type": "boolean"
                  },
                  "sandboxReason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  }
                }
              }
            ]
          },
          "transformPage": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source"
                ],
                "properties": {
                  "source": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "export": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                  },
                  "sandbox": {
                    "type": "boolean"
                  },
                  "sandboxReason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  }
                }
              }
            ]
          }
        }
      },
      "screens": {
        "type": "object",
        "maxProperties": 16,
        "propertyNames": {
          "pattern": "^/[A-Za-z0-9._~-]+(?:/[A-Za-z0-9._~-]+)*$",
          "maxLength": 256
        },
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "collection"
          ],
          "properties": {
            "collection": {
              "type": "string",
              "pattern": "^[a-z][A-Za-z0-9_]{0,63}$"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "columns": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][A-Za-z0-9_]{0,63}$"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "field"
                    ],
                    "properties": {
                      "field": {
                        "type": "string",
                        "pattern": "^[a-z][A-Za-z0-9_]{0,63}$"
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "hooks": [
    {
      "name": "transformView",
      "kind": "filter",
      "description": "Runs before a named kit template renders and returns the view model to render.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "template",
          "view"
        ],
        "properties": {
          "template": {
            "type": "string"
          },
          "view": {
            "type": "object"
          }
        }
      },
      "outputSchema": {
        "type": "object"
      }
    },
    {
      "name": "transformPage",
      "kind": "filter",
      "description": "Runs before the shared page layout renders and may change its title, layout, navigation, account menu or flash message.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page"
        ],
        "properties": {
          "page": {
            "type": "object"
          }
        }
      },
      "outputSchema": {
        "type": "object"
      }
    }
  ],
  "authoring": {
    "description": "Keep the site as one application: customize the installed UI in the project and keep auth/admin behavior in their packages. Use a new extension only for a capability the installed extensions do not provide.",
    "surfaces": [
      {
        "kind": "theme",
        "name": "theme",
        "description": "Set brand name, local assets, semantic light/dark colours, radius and font in extensions.ui.config.theme.",
        "path": "urlcode.yaml#extensions.ui.config.theme"
      },
      {
        "kind": "copy",
        "name": "copy",
        "description": "Override or translate catalogue entries without copying a screen.",
        "path": "ui/copy/<locale>.json"
      },
      {
        "kind": "template",
        "name": "templates",
        "description": "Override only the screen or shared partial whose structure must change; doctor reports view-model drift.",
        "path": "ui/templates/<name>.html",
        "command": "urlcode-ui list --project . --extensions @jimhoyd/urlcode-auth,@jimhoyd/urlcode-admin"
      },
      {
        "kind": "stylesheet",
        "name": "stylesheet",
        "description": "Append project CSS after the shared stylesheet; use semantic shadcn tokens and existing ui-* component classes.",
        "path": "ui/extra.css"
      },
      {
        "kind": "hook",
        "name": "transformView",
        "description": "Add computed project data to a named view immediately before its template renders.",
        "path": "extensions.ui.config.hooks.transformView"
      },
      {
        "kind": "hook",
        "name": "transformPage",
        "description": "Customize the shared page shell, navigation, account menu and flash immediately before layout rendering.",
        "path": "extensions.ui.config.hooks.transformPage"
      }
    ],
    "fastChecks": [
      "urlcode-ui doctor --project . --extensions @jimhoyd/urlcode-auth,@jimhoyd/urlcode-admin --copy ui/copy --templates ui/templates --stylesheet ui/extra.css",
      "urlcode validate --local"
    ]
  },
  "agent": {
    "description": "Local, revision-pinned references for agents configuring the UI extension.",
    "references": [
      {
        "name": "UI extension guide",
        "description": "Configuration and theming guidance for the UI extension.",
        "path": "README.md"
      }
    ]
  }
}
