{
  "name": "@jimhoyd/urlcode-ui",
  "version": "0.6.3",
  "description": "Portable shared presentation for URLCode core and extensions",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jimhoyd-com/urlcode.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/jimhoyd-com/urlcode/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/jimhoyd-com/urlcode/issues"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "default": "./dist/host/index.js"
    },
    "./extension": {
      "types": "./dist/extension.d.ts",
      "default": "./dist/extension.js"
    }
  },
  "files": [
    "dist",
    "urlcode.json",
    "README.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md",
    "vendor/shadcn/LICENSE.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "typecheck": "npm run styles && npm run typecheck:tsc",
    "typecheck:tsc": "tsc --noEmit",
    "build": "npm run styles && npm run build:tsc",
    "build:tsc": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "node --conditions=development --test test/*.test.ts",
    "test:browser": "npm run styles && node --conditions=development --test test/browser/*.browser.ts",
    "verify": "npm run styles && npm run typecheck:tsc && npm run build:tsc && npm test",
    "styles": "node scripts/build-styles.mjs"
  },
  "devDependencies": {
    "@jimhoyd/urlcode": "file:../..",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "26.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@jimhoyd/urlcode": "0.6.3"
  },
  "bin": {
    "urlcode-ui": "dist/host/cli.js"
  }
}
