{
  "name": "@jimhoyd/urlcode-form-records",
  "version": "0.6.1",
  "description": "Operator-installed composition for URLCode: saves a declared form into an owned store collection, with confirmation and constrained edit pages",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jimhoyd-com/urlcode.git",
    "directory": "packages/form-records"
  },
  "homepage": "https://github.com/jimhoyd-com/urlcode/tree/main/packages/form-records#readme",
  "bugs": {
    "url": "https://github.com/jimhoyd-com/urlcode/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./extension": {
      "types": "./dist/extension.d.ts",
      "default": "./dist/extension.js"
    }
  },
  "files": [
    "dist",
    "urlcode.json",
    "README.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "node --conditions=development --test --test-timeout=120000 test/*.test.ts",
    "verify": "npm run typecheck && npm run build && npm test"
  },
  "devDependencies": {
    "@jimhoyd/urlcode": "file:../..",
    "@jimhoyd/urlcode-forms": "file:../forms",
    "@jimhoyd/urlcode-store": "file:../store",
    "@jimhoyd/urlcode-ui": "file:../ui",
    "@types/node": "26.6.2",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@jimhoyd/urlcode": "0.6.1",
    "@jimhoyd/urlcode-forms": "0.6.1",
    "@jimhoyd/urlcode-store": "0.6.1",
    "@jimhoyd/urlcode-ui": "0.6.1"
  },
  "peerDependenciesMeta": {
    "@jimhoyd/urlcode-forms": {
      "optional": true
    },
    "@jimhoyd/urlcode-store": {
      "optional": true
    },
    "@jimhoyd/urlcode-ui": {
      "optional": true
    }
  }
}
