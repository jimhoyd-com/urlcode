{
  "name": "@jimhoyd/urlcode",
  "version": "0.6.6",
  "description": "Portable runtime for programmable URL behavior",
  "type": "module",
  "workspaces": [
    "packages/*",
    "artifacts/*"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18.0",
      "onFail": "error"
    }
  },
  "bin": {
    "urlcode": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "development": "./packages/core/src/index.ts",
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./agent-context": {
      "development": "./packages/core/src/agent-context.ts",
      "types": "./dist/types/agent-context.d.ts",
      "default": "./dist/agent-context.js"
    },
    "./aws": {
      "development": "./packages/core/src/aws.ts",
      "types": "./dist/types/aws.d.ts",
      "default": "./dist/aws.js"
    },
    "./cloudflare": {
      "development": "./packages/core/src/cloudflare.ts",
      "types": "./dist/types/cloudflare.d.ts",
      "default": "./dist/cloudflare.js"
    },
    "./prerender": {
      "development": "./packages/core/src/prerender.ts",
      "types": "./dist/types/prerender.d.ts",
      "default": "./dist/prerender.js"
    },
    "./schema": "./schemas/urlcode.schema.json",
    "./vercel": {
      "development": "./packages/core/src/vercel.ts",
      "types": "./dist/types/vercel.d.ts",
      "default": "./dist/vercel.js"
    },
    "./plugins": {
      "development": "./packages/core/src/plugins.ts",
      "types": "./dist/types/plugins.d.ts",
      "default": "./dist/plugins.js"
    },
    "./policies": {
      "development": "./packages/core/src/policies.ts",
      "types": "./dist/types/policies.d.ts",
      "default": "./dist/policies.js"
    },
    "./compliance": {
      "development": "./packages/core/src/compliance.ts",
      "types": "./dist/types/compliance.d.ts",
      "default": "./dist/compliance.js"
    },
    "./observability": {
      "development": "./packages/core/src/observability.ts",
      "types": "./dist/types/observability.d.ts",
      "default": "./dist/observability.js"
    },
    "./extensions": {
      "development": "./packages/core/src/extensions.ts",
      "types": "./dist/types/extensions.d.ts",
      "default": "./dist/extensions.js"
    },
    "./host": {
      "development": "./packages/core/src/host.ts",
      "types": "./dist/types/host.d.ts",
      "default": "./dist/host.js"
    },
    "./sqlite": {
      "development": "./packages/core/src/sqlite.ts",
      "types": "./dist/types/sqlite.d.ts",
      "default": "./dist/sqlite.js"
    },
    "./sandbox": {
      "development": "./packages/core/src/sandbox.ts",
      "types": "./dist/types/sandbox.d.ts",
      "default": "./dist/sandbox.js"
    },
    "./body-schema": {
      "development": "./packages/core/src/body-schema.ts",
      "types": "./dist/types/body-schema.d.ts",
      "default": "./dist/body-schema.js"
    },
    "./skills": {
      "development": "./packages/core/src/skills.ts",
      "types": "./dist/types/skills.d.ts",
      "default": "./dist/skills.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    ".claude/skills",
    "dist",
    "!dist/scripts",
    "schemas",
    "data",
    "starters",
    "README.md",
    "SECURITY.md",
    "examples",
    "!examples/*/dist/**",
    "llms.txt",
    "llms-full.txt",
    "NOTICE",
    "recipes",
    "skills",
    "docs/AI-AUTHORING.md",
    "docs/YAML-REFERENCE.md",
    "docs/TOOLING.md",
    "docs/FUNCTION-SECURITY.md"
  ],
  "scripts": {
    "build": "node --disable-warning=ExperimentalWarning scripts/build.ts",
    "prepare": "node --disable-warning=ExperimentalWarning scripts/prepare.ts --quiet",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:tooling": "tsc -p tsconfig.checkjs.json",
    "test": "node --conditions=development --import ./test/scratch-tmpdir.ts --test --test-concurrency=2 test/*.test.ts",
    "test:shard": "node --no-wasm-code-gc --conditions=development --import ./test/scratch-tmpdir.ts --test --test-concurrency=2",
    "lint": "eslint .",
    "check": "npm run check:code && npm run check:docs",
    "check:code": "node --disable-warning=ExperimentalWarning scripts/check.ts && node scripts/check-conflict-markers.ts && node scripts/check-core-boundaries.ts && node scripts/check-workspace-links.ts && node scripts/check-issue-labels.ts && node scripts/release-bump.ts --check",
    "test:workerd": "npm run build && node --import ./test/scratch-tmpdir.ts scripts/workerd-parity.ts",
    "verify": "npm run lint && npm run typecheck && npm run typecheck:tooling && npm run check && npm run build && npm test && npm run verify:workspaces",
    "verify:workspaces": "node scripts/workspaces.ts run verify && node scripts/build-addon-manifest.ts --check && npm run audit:packages && npm run test:addons && npm run test:proof && npm run test:proof:authjs && npm run test:proof:native && npm run test:ecosystem",
    "audit:packages": "node scripts/package-audit.ts --all",
    "test:package": "npm run build && npm run test:package:built",
    "dev": "node packages/core/src/cli.ts dev --project starters/default/app",
    "serve": "node packages/core/src/cli.ts serve --project starters/default/app",
    "validate": "node packages/core/src/cli.ts validate --local --project starters/default/app",
    "test:project": "node --import ./test/scratch-tmpdir.ts packages/core/src/cli.ts test --project starters/default/app",
    "init": "node packages/core/src/cli.ts init",
    "doctor": "node packages/core/src/cli.ts doctor",
    "routes": "node packages/core/src/cli.ts routes --project starters/default/app",
    "audit:routes": "node packages/core/src/cli.ts audit --project starters/default/app",
    "measure:plumbing": "node scripts/docs/measure-plumbing.ts",
    "bench:store": "node --conditions=development --disable-warning=ExperimentalWarning packages/store/bench/store-throughput.ts",
    "docs:reference": "node scripts/generate-yaml-reference.ts",
    "docs:plugin": "node scripts/generate-claude-plugin.ts",
    "docs:agents": "node scripts/generate-agent-assets.ts",
    "docs:llms": "node scripts/build-llms-full.ts",
    "docs:extensions": "node scripts/generate-extension-reference.ts",
    "docs:cookbook-index": "node scripts/build-cookbook-index.ts",
    "create-extension": "node scripts/create-extension.ts",
    "sync:agents": "node scripts/sync-agent-lists.ts",
    "check:docs": "node scripts/check-trust-model-prose.ts && node scripts/check-version-statements.ts && node scripts/check-local-links.ts && node scripts/check-doc-yaml.ts && node scripts/check-guidance-claims.ts && node scripts/check-agent-facts.ts && node scripts/generate-yaml-reference.ts --check && node scripts/generate-extension-reference.ts --check && node scripts/build-llms-full.ts --check && node scripts/build-cookbook-index.ts --check && node scripts/generate-agent-assets.ts --check",
    "ci:build-fidelity": "node scripts/ci-build-fidelity.ts",
    "ci:container-smoke": "node scripts/ci-container-smoke.ts",
    "test:examples": "npm run build && npm run test:examples:built",
    "test:examples:built": "node --import ./test/scratch-tmpdir.ts dist/cli.js test --project starters/default/app && node --import ./test/scratch-tmpdir.ts dist/cli.js test --project examples/assets && node --import ./test/scratch-tmpdir.ts dist/cli.js test --project examples/cookbook && node --import ./test/scratch-tmpdir.ts dist/cli.js test --project examples/vercel && node --import ./test/scratch-tmpdir.ts dist/cli.js test --project examples/aws && node --import ./test/scratch-tmpdir.ts dist/cli.js test --project examples/cloudflare && node --import ./test/scratch-tmpdir.ts dist/cli.js build --target cloudflare --project examples/cloudflare --out examples/cloudflare/dist && node --import ./test/scratch-tmpdir.ts dist/cli.js audit --project examples/cookbook --expect-routes 40",
    "test:package:built": "node --import ./test/scratch-tmpdir.ts scripts/package-audit.ts . && node --import ./test/scratch-tmpdir.ts scripts/package-smoke.ts",
    "audit:package-only": "node scripts/package-audit.ts .",
    "ci:history": "node scripts/ci-history.ts",
    "ci:report": "node scripts/ci-report.ts",
    "release:bump": "node scripts/release-bump.ts",
    "release:pack": "node scripts/release-pack.ts",
    "release:publish": "node scripts/release-publish.ts",
    "build:addons": "node scripts/workspaces.ts run build && node scripts/build-addon-manifest.ts && node scripts/generate-extension-reference.ts",
    "test:addons": "node --import ./test/scratch-tmpdir.ts --test test/addons.integration.ts",
    "test:proof": "node --import ./test/scratch-tmpdir.ts --test test/private-requests.integration.ts",
    "test:proof:authjs": "node --import ./test/scratch-tmpdir.ts --test test/authjs-provider.integration.ts",
    "test:proof:native": "node --import ./test/scratch-tmpdir.ts --test test/native-storage.integration.ts",
    "test:ecosystem": "node --import ./test/scratch-tmpdir.ts --test test/ecosystem.integration.ts",
    "test:disk-full": "node --import ./test/scratch-tmpdir.ts --test test/disk-full.integration.ts",
    "verify:addons": "npm run build && node scripts/workspaces.ts run build && npm run audit:packages && npm run test:addons"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jimhoyd-com/urlcode.git"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.1.0",
    "ajv": "8.20.0",
    "content-disposition": "3.0.0",
    "es-module-lexer": "3.0.2",
    "mime-types": "3.0.2",
    "quickjs-emscripten": "0.32.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@modelcontextprotocol/client": "2.1.0",
    "@types/mime-types": "3.0.1",
    "@types/node": "26.6.3",
    "@types/semver": "7.8.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "picomatch": "^4.0.7",
    "semver": "7.8.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  },
  "peerDependencies": {
    "typescript": ">=6.0.3 <7.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "homepage": "https://github.com/jimhoyd-com/urlcode#readme",
  "bugs": {
    "url": "https://github.com/jimhoyd-com/urlcode/issues"
  },
  "overrides": {
    "@hey-api/json-schema-ref-parser": {
      "js-yaml": "4.3.2"
    }
  }
}
