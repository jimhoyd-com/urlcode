{
  "name": "urlcode",
  "version": "0.1.0",
  "description": "Portable runtime for programmable URL behavior",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "urlcode": "./src/cli.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./prerender": "./src/prerender.js",
    "./schema": "./schemas/urlcode.schema.json"
  },
  "files": [
    "src",
    "schemas",
    "starters",
    "README.md",
    "docs",
    "SECURITY.md",
    "ROADMAP.md",
    "CONTRIBUTING.md",
    "examples",
    "llms.txt"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "check": "node scripts/check.js && node scripts/generate-yaml-reference.js --check",
    "verify": "npm run lint && npm run check && npm test",
    "benchmark": "node benchmarks/routing.js",
    "test:package": "node scripts/package-smoke.js",
    "dev": "node src/cli.js dev --project starters/default",
    "serve": "node src/cli.js serve --project starters/default",
    "validate": "node src/cli.js validate --local --project starters/default",
    "test:project": "node src/cli.js test --project starters/default",
    "init": "node src/cli.js init",
    "doctor": "node src/cli.js doctor",
    "routes": "node src/cli.js routes --project starters/default",
    "audit:routes": "node src/cli.js audit --project starters/default",
    "benchmark:project": "node src/cli.js benchmark --project starters/default",
    "docs:reference": "node scripts/generate-yaml-reference.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jimhoyd-com/urlcode.git"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "content-disposition": "3.0.0",
    "es-module-lexer": "3.0.2",
    "mime-types": "3.0.2",
    "quickjs-emscripten": "0.32.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "globals": "17.12.0"
  }
}
