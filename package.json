{
  "name": "@jimhoyd/urlcode-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Portable shared presentation for URLCode core and extensions",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./host": {
      "development": "./src/host/index.ts",
      "types": "./dist/host/index.d.ts",
      "default": "./dist/host/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRACT.md",
    "THREAT-MODEL.md",
    "IMPLEMENTATION-STATUS.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --conditions=development --test test/*.test.ts",
    "verify": "npm run typecheck && npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "typescript": "6.0.3"
  },
  "bin": {
    "urlcode-ui": "./dist/host/cli.js"
  }
}
