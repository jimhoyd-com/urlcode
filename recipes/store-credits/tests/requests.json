  {"path": "/api/wallets", "method": "POST", "headers": {"authorization": "Bearer alice", "origin": "{{origin}}", "content-type": "application/json"}, "body": "{\"handle\":\"rich\",\"balance\":50}", "status": 422},
  {"path": "/api/wallets", "method": "POST", "headers": {"authorization": "Bearer alice", "origin": "{{origin}}", "content-type": "application/json"}, "body": "{\"handle\":\"Bob\"}", "status": 422},
  {"path": "/api/wallets/transfers/pay", "headers": {"authorization": "Bearer alice"}, "status": 405},
