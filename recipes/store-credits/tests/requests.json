    {"path": "/api/wallets", "method": "POST", "headers": {"authorization": "Bearer alice", "origin": "{{origin}}", "content-type": "application/json"}, "body": "{\"handle\":\"alice\"}", "status": 201, "expectJson": {"/balance": 0}, "capture": {"alice": {"json": "id"}}},
    {"path": "/api/wallets", "method": "POST", "headers": {"authorization": "Bearer bob", "origin": "{{origin}}", "content-type": "application/json"}, "body": "{\"handle\":\"bob\"}", "status": 201, "expectJson": {"/balance": 0}, "capture": {"bob": {"json": "id"}}},
    {"path": "/api/wallets", "method": "POST", "headers": {"authorization": "Bearer bob", "origin": "{{origin}}", "content-type": "application/json"}, "body": "{\"handle\":\"alice\"}", "status": 409, "expectJson": {"/error/code": "value_taken"}},
    {"path": "/api/wallets/transfers/issue", "method": "POST", "headers": {"authorization": "Bearer alice", "origin": "{{origin}}", "content-type": "application/json"}, "body": "{\"from\":\"{{alice}}\",\"to\":\"{{bob}}\",\"amount\":5}", "status": 403, "expectJson": {"/error/code": "membership_required"}},
