    {"path": "/api/wallets/transfers/pay", "method": "POST", "headers": {"authorization": "Bearer alice", "origin": "{{origin}}", "content-type": "application/json"}, "body": "{\"from\":\"{{alice}}\",\"to\":\"{{bob}}\",\"amount\":1.5}", "status": 422},
    {"path": "/api/wallets/transfers/pay", "method": "POST", "headers": {"authorization": "Bearer bob", "origin": "{{origin}}", "content-type": "application/json"}, "body": "{\"from\":\"{{alice}}\",\"to\":\"{{bob}}\",\"amount\":1}", "status": 404},
    {"path": "/api/wallets/{{alice}}", "headers": {"authorization": "Bearer alice"}, "status": 200, "expectJson": {"/handle": "alice", "/balance": 70}},
