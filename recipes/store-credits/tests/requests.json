    {"path": "/api/directory?handle=bob", "headers": {"authorization": "Bearer alice"}, "status": 200, "expectJson": {"/items": [{"id": "{{bob}}", "handle": "bob"}]}, "capture": {"to": {"json": "items.0.id"}}},
