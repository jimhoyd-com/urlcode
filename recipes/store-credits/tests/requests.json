    {"path": "/api/wallets/{{alice}}", "method": "PATCH", "headers": {"authorization": "Bearer alice", "origin": "{{origin}}", "content-type": "application/json"}, "body": "{\"handle\":\"bob\"}", "status": 409, "expectJson": {"/error/code": "value_taken"}},
    {"path": "/api/wallets/{{alice}}", "method": "PATCH", "headers": {"authorization": "Bearer alice", "origin": "{{origin}}", "content-type": "application/json"}, "body": "{\"handle\":\"alice_w\"}", "status": 200, "expectJson": {"/handle": "alice_w", "/balance": 70}},
    {"path": "/api/wallets/{{alice}}", "method": "PUT", "headers": {"authorization": "Bearer alice", "origin": "{{origin}}", "content-type": "application/json"}, "body": "{\"handle\":\"alice\"}", "status": 200, "expectJson": {"/handle": "alice", "/balance": 70}},
    {"path": "/api/wallets/{{alice}}", "method": "DELETE", "headers": {"authorization": "Bearer alice", "origin": "{{origin}}"}, "status": 409, "expectJson": {"/error/code": "balance_not_zero"}},
    {"path": "/api/wallets/transfers/pay", "method": "POST", "headers": {"authorization": "Bearer bob", "origin": "{{origin}}", "content-type": "application/json"}, "body": "{\"from\":\"{{bob}}\",\"to\":\"{{mint}}\",\"amount\":30}", "status": 200, "expectJson": {"/from/balance": 0}},
    {"path": "/api/wallets/transfers/pay", "method": "POST", "headers": {"authorization": "Bearer alice", "origin": "{{origin}}", "content-type": "application/json"}, "body": "{\"from\":\"{{alice}}\",\"to\":\"{{mint}}\",\"amount\":70}", "status": 200, "expectJson": {"/from/balance": 0}},
    {"path": "/api/wallets", "headers": {"authorization": "Bearer treasurer"}, "status": 200, "expectJson": {"/total": 1, "/items/0/balance": 0}},
