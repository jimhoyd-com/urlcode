[
  {
    "path": "/",
    "status": 200,
    "expectHeaders": {
      "content-type": "text/html; charset=utf-8",
      "cache-control": "no-cache"
    }
  },
  {
    "path": "/assets/contact.js",
    "status": 200,
    "expectHeaders": {
      "cache-control": "no-cache"
    }
  },
  {
    "path": "/assets/missing.js",
    "status": 404
  },
  {
    "path": "/contact",
    "method": "POST",
    "headers": {
      "content-type": "application/json"
    },
    "body": "{\"name\":\"Ada\",\"email\":\"ada@example.com\",\"message\":\"Please send the brochure.\"}",
    "status": 202,
    "expectBody": "{\"accepted\":true}",
    "expectHeaders": {
      "cache-control": "no-store"
    },
    "expectSignals": [
      {
        "destination": "https://hooks.example.com",
        "count": 1,
        "match": {
          "/route": "/contact",
          "/method": "POST",
          "/status": 202
        }
      }
    ]
  },
  {
    "path": "/contact",
    "method": "POST",
    "headers": {
      "content-type": "application/json"
    },
    "body": "{\"name\":\"Ada\",\"email\":\"not-an-address\",\"message\":\"Please send the brochure.\"}",
    "status": 422,
    "expectSignals": []
  },
  {
    "path": "/contact",
    "method": "POST",
    "headers": {
      "content-type": "application/json"
    },
    "body": "{\"name\":\"   \",\"email\":\"ada@example.com\",\"message\":\"Please send the brochure.\"}",
    "status": 422
  },
  {
    "path": "/contact",
    "method": "POST",
    "headers": {
      "content-type": "application/json"
    },
    "body": "{\"email\":\"ada@example.com\",\"message\":\"Please send the brochure.\"}",
    "status": 422
  },
  {
    "path": "/contact",
    "method": "POST",
    "headers": {
      "content-type": "application/json"
    },
    "body": "\"just a string\"",
    "status": 422
  },
  {
    "path": "/contact",
    "method": "POST",
    "headers": {
      "content-type": "application/x-www-form-urlencoded"
    },
    "body": "name=Ada",
    "status": 415,
    "expectSignals": []
  },
  {
    "path": "/contact",
    "status": 405
  }
]
