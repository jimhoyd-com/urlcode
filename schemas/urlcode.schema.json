{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jimhoyd-com/urlcode/main/schemas/urlcode.schema.json",
  "type": "object",
  "properties": {
    "version": {
      "const": "1"
    },
    "routes": {
      "type": "object",
      "maxProperties": 100000,
      "additionalProperties": {
        "$ref": "#/$defs/route"
      }
    },
    "includes": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1024
      },
      "uniqueItems": true,
      "maxItems": 256
    },
    "dynamicLinks": {
      "type": "boolean",
      "default": false,
      "description": "Entry-point opt-in for live stored-link routes. Does not enable guest storage or management access."
    },
    "policies": {
      "$ref": "#/$defs/policies"
    },
    "profiles": {
      "type": "object",
      "description": "Reusable named policy sets selectable with policies.profile. A name shadows a built-in profile of the same name.",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "throttle": {
            "oneOf": [
              {
                "const": false
              },
              {
                "$ref": "#/$defs/policyThrottle"
              }
            ]
          },
          "agents": {
            "oneOf": [
              {
                "const": false
              },
              {
                "$ref": "#/$defs/policyAgents"
              }
            ]
          },
          "security": {
            "oneOf": [
              {
                "const": false
              },
              {
                "$ref": "#/$defs/policySecurity"
              }
            ]
          },
          "compression": {
            "oneOf": [
              {
                "const": false
              },
              {
                "$ref": "#/$defs/policyCompression"
              }
            ]
          },
          "cache": {
            "oneOf": [
              {
                "const": false
              },
              {
                "$ref": "#/$defs/policyCache"
              }
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "routes"
  ],
  "additionalProperties": false,
  "$defs": {
    "route": {
      "type": "object",
      "properties": {
        "methods": {
          "type": "array",
          "items": {
            "enum": [
              "GET",
              "HEAD",
              "POST",
              "PUT",
              "PATCH",
              "DELETE",
              "OPTIONS"
            ]
          },
          "minItems": 1,
          "uniqueItems": true,
          "default": [
            "GET",
            "HEAD"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "expires": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "maxLength": 1024
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
              },
              "in": {
                "enum": [
                  "path",
                  "query",
                  "header"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "schema": {
                "type": "object",
                "properties": {
                  "type": {
                    "enum": [
                      "string",
                      "integer",
                      "number",
                      "boolean",
                      "array"
                    ]
                  },
                  "enum": {
                    "type": "array",
                    "items": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "default": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "array"
                    ],
                    "items": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    }
                  },
                  "minLength": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 8192
                  },
                  "maxLength": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 8192
                  },
                  "minimum": {
                    "type": "number"
                  },
                  "maximum": {
                    "type": "number"
                  },
                  "items": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "enum": [
                          "string",
                          "integer",
                          "number",
                          "boolean"
                        ]
                      }
                    },
                    "required": [
                      "type"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "name",
              "in",
              "schema"
            ],
            "additionalProperties": false
          },
          "maxItems": 64
        },
        "redirect": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "maxLength": 8192
            },
            "status": {
              "enum": [
                301,
                302,
                303,
                307,
                308
              ]
            },
            "query": {
              "type": "object",
              "properties": {
                "pass": {
                  "oneOf": [
                    {
                      "const": false
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "uniqueItems": true
                    }
                  ]
                },
                "map": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "from": {
                        "enum": [
                          "path",
                          "query",
                          "header"
                        ]
                      },
                      "name": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "from",
                      "name"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [
            "url"
          ],
          "additionalProperties": false
        },
        "function": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "maxLength": 1024
            },
            "export": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "args": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "from": {
                        "enum": [
                          "path",
                          "query",
                          "header"
                        ]
                      },
                      "name": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "from",
                      "name"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "env": {
                        "type": "string",
                        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                      }
                    },
                    "required": [
                      "env"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "secret": {
                        "type": "string",
                        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                      }
                    },
                    "required": [
                      "secret"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "required": [
            "source"
          ],
          "additionalProperties": false
        },
        "env": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string"
                  }
                },
                "required": [
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "env": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                  }
                },
                "required": [
                  "env"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "secrets": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "secret": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              }
            },
            "required": [
              "secret"
            ],
            "additionalProperties": false
          }
        },
        "page": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "contentType": {
              "type": "string",
              "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$",
              "maxLength": 128
            },
            "cacheControl": {
              "enum": [
                "no-cache",
                "no-store",
                "public, max-age=3600",
                "public, max-age=31536000, immutable"
              ]
            }
          },
          "required": [
            "file"
          ],
          "additionalProperties": false
        },
        "download": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "contentType": {
              "type": "string",
              "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$",
              "maxLength": 128
            },
            "cacheControl": {
              "enum": [
                "no-cache",
                "no-store",
                "public, max-age=3600",
                "public, max-age=31536000, immutable"
              ]
            },
            "filename": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          },
          "required": [
            "file"
          ],
          "additionalProperties": false
        },
        "static": {
          "type": "object",
          "properties": {
            "directory": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "contentType": {
              "type": "string",
              "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$",
              "maxLength": 128
            },
            "cacheControl": {
              "enum": [
                "no-cache",
                "no-store",
                "public, max-age=3600",
                "public, max-age=31536000, immutable"
              ]
            },
            "index": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+\\.html$"
            }
          },
          "required": [
            "directory"
          ],
          "additionalProperties": false
        },
        "request": {
          "type": "object",
          "properties": {
            "body": {
              "type": "object",
              "properties": {
                "required": {
                  "type": "boolean"
                },
                "maxBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1048576
                },
                "contentTypes": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
                  }
                },
                "format": {
                  "enum": [
                    "text",
                    "json"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "response": {
          "type": "object",
          "properties": {
            "headers": {
              "type": "object",
              "maxProperties": 64,
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "string",
                    "maxLength": 4096
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 16,
                    "items": {
                      "type": "string",
                      "maxLength": 4096
                    }
                  }
                ]
              }
            }
          },
          "additionalProperties": false
        },
        "respond": {
          "type": "object",
          "properties": {
            "status": {
              "type": "integer",
              "minimum": 200,
              "maximum": 599
            },
            "text": {
              "type": "string",
              "maxLength": 1048576
            },
            "json": {}
          },
          "additionalProperties": false,
          "not": {
            "required": [
              "text",
              "json"
            ]
          }
        },
        "middleware": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "maxLength": 1024
              },
              "export": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              }
            },
            "required": [
              "source"
            ],
            "additionalProperties": false
          }
        },
        "link": {
          "type": "object",
          "properties": {
            "collection": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "code": {
              "type": "object",
              "properties": {
                "from": {
                  "const": "path"
                },
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                }
              },
              "required": [
                "from",
                "name"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "collection",
            "code"
          ],
          "additionalProperties": false
        },
        "policies": {
          "$ref": "#/$defs/policies"
        }
      },
      "required": [],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "redirect"
          ]
        },
        {
          "required": [
            "function"
          ]
        },
        {
          "required": [
            "page"
          ]
        },
        {
          "required": [
            "download"
          ]
        },
        {
          "required": [
            "static"
          ]
        },
        {
          "required": [
            "respond"
          ]
        },
        {
          "required": [
            "link"
          ]
        }
      ]
    },
    "policyThrottle": {
      "type": "object",
      "description": "Per-client request budget expressed like the IETF RateLimit-Policy field: quota requests per window seconds.",
      "properties": {
        "quota": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "window": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400,
          "description": "Seconds"
        },
        "partition": {
          "enum": [
            "client",
            "route",
            "client-route"
          ],
          "default": "client"
        },
        "status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599,
          "default": 429
        },
        "mode": {
          "enum": [
            "enforce",
            "report"
          ],
          "default": "enforce"
        },
        "maxKeys": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 10000000,
          "default": 100000
        }
      },
      "required": [
        "quota",
        "window"
      ],
      "additionalProperties": false
    },
    "policyAgents": {
      "type": "object",
      "description": "User-Agent policy. Named lists ship with the runtime; project-relative .json files in the same schema supply your own.",
      "properties": {
        "deny": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "uniqueItems": true,
          "maxItems": 32
        },
        "allow": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "uniqueItems": true,
          "maxItems": 32
        },
        "denyPatterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true,
          "maxItems": 256
        },
        "allowPatterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true,
          "maxItems": 256
        },
        "denyEmpty": {
          "type": "boolean",
          "default": false,
          "description": "Deny requests that send no User-Agent"
        },
        "status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599,
          "default": 403
        },
        "mode": {
          "enum": [
            "enforce",
            "report"
          ],
          "default": "enforce"
        }
      },
      "additionalProperties": false
    },
    "policySecurity": {
      "type": "object",
      "description": "Response security headers. Profiles follow the OWASP Secure Headers Project; set overrides or adds individual headers; unset removes one from the profile.",
      "properties": {
        "headers": {
          "enum": [
            "oshp",
            "oshp-no-csp",
            "off"
          ],
          "default": "oshp"
        },
        "set": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "unset": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "uniqueItems": true,
          "maxItems": 32
        }
      },
      "additionalProperties": false
    },
    "policyCompression": {
      "type": "object",
      "description": "Content-coding negotiation per RFC 9110. Assets are precompressed at snapshot time; other bodies compress on the request path.",
      "properties": {
        "encodings": {
          "type": "array",
          "items": {
            "enum": [
              "br",
              "gzip",
              "deflate",
              "zstd"
            ]
          },
          "minItems": 1,
          "uniqueItems": true,
          "default": [
            "br",
            "gzip"
          ]
        },
        "minBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576,
          "default": 1024
        },
        "types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "uniqueItems": true,
          "maxItems": 64
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 11
        },
        "allowWithSecrets": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "policyCache": {
      "type": "object",
      "description": "Named HTTP caching strategy per RFC 9111/5861/8246/9213; explicit fields override what the strategy implies.",
      "properties": {
        "strategy": {
          "enum": [
            "no-store",
            "revalidate",
            "public",
            "immutable",
            "swr",
            "sie",
            "micro",
            "cdn-only",
            "private"
          ]
        },
        "maxAge": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31536000,
          "description": "Seconds"
        },
        "staleWhileRevalidate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31536000
        },
        "staleIfError": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31536000
        },
        "cdnMaxAge": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31536000
        },
        "originTtl": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400,
          "description": "Seconds an origin memory cache may serve a stored response"
        },
        "vary": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "uniqueItems": true,
          "maxItems": 8
        },
        "statuses": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 200,
            "maximum": 599
          },
          "uniqueItems": true,
          "maxItems": 16
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216,
          "description": "Largest body the origin cache stores"
        },
        "maxEntries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "force": {
          "type": "boolean",
          "default": false,
          "description": "Allow immutable on a path without a content hash"
        }
      },
      "required": [
        "strategy"
      ],
      "additionalProperties": false
    },
    "policies": {
      "type": "object",
      "description": "Optional host-enforced behavior around routes. Every key is off unless declared. Route policies merge over project policies; false disables one.",
      "properties": {
        "profile": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "description": "Built-in (hardened) or a name under top-level profiles"
        },
        "throttle": {
          "oneOf": [
            {
              "const": false
            },
            {
              "$ref": "#/$defs/policyThrottle"
            }
          ]
        },
        "agents": {
          "oneOf": [
            {
              "const": false
            },
            {
              "$ref": "#/$defs/policyAgents"
            }
          ]
        },
        "security": {
          "oneOf": [
            {
              "const": false
            },
            {
              "$ref": "#/$defs/policySecurity"
            }
          ]
        },
        "compression": {
          "oneOf": [
            {
              "const": false
            },
            {
              "$ref": "#/$defs/policyCompression"
            }
          ]
        },
        "cache": {
          "oneOf": [
            {
              "const": false
            },
            {
              "$ref": "#/$defs/policyCache"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
