{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jimhoyd-com/urlcode/main/schemas/urlcode.schema.json",
  "type": "object",
  "properties": {
    "version": {
      "const": "1"
    },
    "routes": {
      "type": "object",
      "maxProperties": 100000,
      "additionalProperties": {
        "$ref": "#/$defs/route"
      }
    },
    "includes": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1024
      },
      "uniqueItems": true,
      "maxItems": 256
    }
  },
  "required": [
    "version",
    "routes"
  ],
  "additionalProperties": false,
  "$defs": {
    "route": {
      "type": "object",
      "properties": {
        "methods": {
          "type": "array",
          "items": {
            "enum": [
              "GET",
              "HEAD",
              "POST",
              "PUT",
              "PATCH",
              "DELETE",
              "OPTIONS"
            ]
          },
          "minItems": 1,
          "uniqueItems": true,
          "default": [
            "GET",
            "HEAD"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "expires": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "maxLength": 1024
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
              },
              "in": {
                "enum": [
                  "path",
                  "query",
                  "header"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "schema": {
                "type": "object",
                "properties": {
                  "type": {
                    "enum": [
                      "string",
                      "integer",
                      "number",
                      "boolean",
                      "array"
                    ]
                  },
                  "enum": {
                    "type": "array",
                    "items": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "default": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "array"
                    ],
                    "items": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    }
                  },
                  "minLength": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 8192
                  },
                  "maxLength": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 8192
                  },
                  "minimum": {
                    "type": "number"
                  },
                  "maximum": {
                    "type": "number"
                  },
                  "items": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "enum": [
                          "string",
                          "integer",
                          "number",
                          "boolean"
                        ]
                      }
                    },
                    "required": [
                      "type"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "name",
              "in",
              "schema"
            ],
            "additionalProperties": false
          },
          "maxItems": 64
        },
        "redirect": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "maxLength": 8192
            },
            "status": {
              "enum": [
                301,
                302,
                303,
                307,
                308
              ]
            },
            "query": {
              "type": "object",
              "properties": {
                "pass": {
                  "oneOf": [
                    {
                      "const": false
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "uniqueItems": true
                    }
                  ]
                },
                "map": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "from": {
                        "enum": [
                          "path",
                          "query",
                          "header"
                        ]
                      },
                      "name": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "from",
                      "name"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [
            "url"
          ],
          "additionalProperties": false
        },
        "function": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "maxLength": 1024
            },
            "export": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "args": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "from": {
                        "enum": [
                          "path",
                          "query",
                          "header"
                        ]
                      },
                      "name": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "from",
                      "name"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "env": {
                        "type": "string",
                        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                      }
                    },
                    "required": [
                      "env"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "secret": {
                        "type": "string",
                        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                      }
                    },
                    "required": [
                      "secret"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "required": [
            "source"
          ],
          "additionalProperties": false
        },
        "env": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string"
                  }
                },
                "required": [
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "env": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                  }
                },
                "required": [
                  "env"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "secrets": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "secret": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              }
            },
            "required": [
              "secret"
            ],
            "additionalProperties": false
          }
        },
        "page": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "contentType": {
              "type": "string",
              "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$",
              "maxLength": 128
            },
            "cacheControl": {
              "enum": [
                "no-cache",
                "no-store",
                "public, max-age=3600",
                "public, max-age=31536000, immutable"
              ]
            }
          },
          "required": [
            "file"
          ],
          "additionalProperties": false
        },
        "download": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "contentType": {
              "type": "string",
              "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$",
              "maxLength": 128
            },
            "cacheControl": {
              "enum": [
                "no-cache",
                "no-store",
                "public, max-age=3600",
                "public, max-age=31536000, immutable"
              ]
            },
            "filename": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          },
          "required": [
            "file"
          ],
          "additionalProperties": false
        },
        "static": {
          "type": "object",
          "properties": {
            "directory": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "contentType": {
              "type": "string",
              "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$",
              "maxLength": 128
            },
            "cacheControl": {
              "enum": [
                "no-cache",
                "no-store",
                "public, max-age=3600",
                "public, max-age=31536000, immutable"
              ]
            },
            "index": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+\\.html$"
            }
          },
          "required": [
            "directory"
          ],
          "additionalProperties": false
        },
        "request": {
          "type": "object",
          "properties": {
            "body": {
              "type": "object",
              "properties": {
                "required": {
                  "type": "boolean"
                },
                "maxBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1048576
                },
                "contentTypes": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
                  }
                },
                "format": {
                  "enum": [
                    "text",
                    "json"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "response": {
          "type": "object",
          "properties": {
            "headers": {
              "type": "object",
              "maxProperties": 64,
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "string",
                    "maxLength": 4096
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 16,
                    "items": {
                      "type": "string",
                      "maxLength": 4096
                    }
                  }
                ]
              }
            }
          },
          "additionalProperties": false
        },
        "respond": {
          "type": "object",
          "properties": {
            "status": {
              "type": "integer",
              "minimum": 200,
              "maximum": 599
            },
            "text": {
              "type": "string",
              "maxLength": 1048576
            },
            "json": {}
          },
          "additionalProperties": false,
          "not": {
            "required": [
              "text",
              "json"
            ]
          }
        },
        "middleware": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "maxLength": 1024
              },
              "export": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              }
            },
            "required": [
              "source"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "redirect"
          ]
        },
        {
          "required": [
            "function"
          ]
        },
        {
          "required": [
            "page"
          ]
        },
        {
          "required": [
            "download"
          ]
        },
        {
          "required": [
            "static"
          ]
        },
        {
          "required": [
            "respond"
          ]
        }
      ]
    }
  }
}
