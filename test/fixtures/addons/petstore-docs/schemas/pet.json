{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pet",
  "type": "object",
  "required": ["id", "name"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "tags": { "type": "array", "items": { "$ref": "#/$defs/tag" } }
  },
  "$defs": {
    "tag": { "type": "string", "maxLength": 32 }
  }
}
